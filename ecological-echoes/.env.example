DATABASE_URL=postgres://...        # from Vercel Storage > Neon (Postgres)
BLOB_READ_WRITE_TOKEN=...          # from Vercel Storage > Blob
SESSION_SECRET=long-random-string  # e.g. run: openssl rand -hex 32
ADMIN_USERNAMES=yourusername        # comma-separated; these accounts can edit/delete anything
SITE_URL=https://your-site.vercel.app
RESEND_API_KEY=re_...               # resend.com, for password-reset emails
RESEND_FROM="Ecological Echoes <noreply@your-domain.com>"
